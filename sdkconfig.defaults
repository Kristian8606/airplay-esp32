CONFIG_IDF_TARGET="esp32s3"
# AirPlay receiver defaults
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ESP32-S3 N8R8 uses quad flash + octal PSRAM. QIO reads code from flash
# over 4 data lines (DIO uses 2), so instruction-cache misses refill faster.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
# Data cache stays at the 32 KB default: 64 KB would take 32 KB of internal
# RAM, and only ~60 KiB is free after audio init.

# AirPlay RX/burst-priority WiFi/LwIP profile (Espressif performance-oriented).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=85
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=n
CONFIG_MDNS_MAX_SERVICES=4
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# PSA crypto state is shared by pairing and encrypted streaming tasks.
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y
# CONFIG_MBEDTLS_THREADING_ALT is not set
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
# Realtime streaming TCP/LwIP sizing.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
# Console UART at 921600: without a UART driver every log line busy-waits
# until it is sent; at 115200 a 100-char line blocks its task ~9 ms (RTSP
# logs run at priority 17 on core 0, above PTP/ALAC/AAC). 921600 = ~1.1 ms.
# Same UART0 and pins (TX 43 / RX 44) as the default console; only the ROM
# boot messages stay at 115200. idf.py monitor follows this rate.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_HTTPD_WS_SUPPORT=y

# Keep I2S DMA EOF timing alive while flash cache is temporarily disabled.
CONFIG_I2S_ISR_IRAM_SAFE=y

# Amplifier power control
CONFIG_AIRPLAY_AMP_CONTROL=y
CONFIG_AIRPLAY_AMP_GPIO=21
CONFIG_AIRPLAY_AMP_ACTIVE_HIGH=y
CONFIG_AIRPLAY_AMP_OFF_DELAY_SEC=300

# AirPlay diagnostics (menuconfig "AirPlay Logs and Diagnostics")
CONFIG_AIRPLAY_DIAG_PLAYOUT=n
CONFIG_AIRPLAY_DIAG_LIFECYCLE=n
CONFIG_AIRPLAY_DIAG_AUTOMIX=n