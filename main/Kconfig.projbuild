menuconfig AIRPLAY_DIAGNOSTICS
    bool "Enable temporary AirPlay diagnostics"
    default n
    help
        Master compile-time switch for temporary AirPlay diagnostics.
        The permanent 2-second audio_status log is independent and remains
        available when this option is disabled.

        When disabled, category counters, timestamps, arrays, buffers, helper
        functions and the low-priority audio_diag task are not compiled.

if AIRPLAY_DIAGNOSTICS

    config AIRPLAY_DIAG_TRANSPORT
        bool "TRANSPORT - TCP/UDP RX, sequence and retransmit diagnostics"
        default n

    config AIRPLAY_DIAG_BUFFER
        bool "BUFFER - AAC store, ALAC queues and PCM ring diagnostics"
        default n

    config AIRPLAY_DIAG_FLUSH
        bool "FLUSH - FLUSH/FLUSHBUFFERED/AutoMix diagnostics"
        default n

    config AIRPLAY_DIAG_CODEC
        bool "CODEC - AAC/ALAC decoder diagnostics"
        default n

    config AIRPLAY_DIAG_SYNC
        bool "SYNC - PTP, anchors, PID and ppm diagnostics"
        default n

    config AIRPLAY_DIAG_PLAYOUT
        bool "PLAYOUT - scheduler, I2S, DMA and late/early diagnostics"
        default n

    config AIRPLAY_DIAG_LIFECYCLE
        bool "LIFECYCLE - task/session/generation/race diagnostics"
        default n

    config AIRPLAY_DIAG_ACTIVE
        bool
        default y if AIRPLAY_DIAG_TRANSPORT || AIRPLAY_DIAG_BUFFER || AIRPLAY_DIAG_FLUSH || AIRPLAY_DIAG_CODEC || AIRPLAY_DIAG_SYNC || AIRPLAY_DIAG_PLAYOUT || AIRPLAY_DIAG_LIFECYCLE
        default n

    config AIRPLAY_DIAG_HIGH_RATE_TRACE
        bool "Allow high-rate packet/sample/block tracing"
        depends on AIRPLAY_DIAG_ACTIVE
        default n
        help
            Enables diagnostics which may record every packet, sample block or
            other high-frequency event. Use only for short targeted tests.
            Audio must never block waiting for diagnostic output; trace data
            may be dropped instead.

endif

menu "AirPlay Receiver"
    config DEFAULT_AP_SSID
        string "Setup AP SSID"
        default "ESP32-AirPlay-Setup"
    config DEFAULT_AP_PASSWORD
        string "Setup AP password"
        default ""
    config DEFAULT_AP_CHANNEL
        int "Setup AP channel"
        default 1
        range 1 13
    config WIFI_PREFER_5GHZ
        bool "Prefer 5 GHz when available"
        default n
    config WIFI_PREFER_5GHZ_MIN_RSSI
        int "Minimum 5 GHz RSSI"
        default -75
        range -95 -30
        depends on WIFI_PREFER_5GHZ
    config ENABLE_AIRPLAY_ARTWORK
        bool "Advertise artwork support"
        default n
endmenu

menu "Amplifier Power Control"
    config AIRPLAY_AMP_CONTROL
        bool "Enable amplifier power control GPIO"
        default y
        help
            Drive an amplifier enable/standby GPIO from a dedicated low-priority
            task. RTSP code only updates the session state and wakes that task;
            GPIO access and the delayed power-off never run in the audio/RTSP path.

    config AIRPLAY_AMP_GPIO
        int "Amplifier control GPIO"
        default 21
        range 0 48
        depends on AIRPLAY_AMP_CONTROL

    choice AIRPLAY_AMP_ACTIVE_LEVEL
        prompt "Amplifier GPIO active level"
        default AIRPLAY_AMP_ACTIVE_HIGH
        depends on AIRPLAY_AMP_CONTROL

        config AIRPLAY_AMP_ACTIVE_HIGH
            bool "Active HIGH"

        config AIRPLAY_AMP_ACTIVE_LOW
            bool "Active LOW"
    endchoice

    config AIRPLAY_AMP_OFF_DELAY_SEC
        int "Amplifier power-off delay after AirPlay disconnect (seconds)"
        default 300
        range 0 3600
        depends on AIRPLAY_AMP_CONTROL
        help
            The amplifier remains enabled while at least one AirPlay control
            session is active. After the last session disconnects, the amp task
            waits this long before switching the GPIO inactive. A reconnect
            during the delay keeps the amplifier on.
endmenu

menu "I2S Playout"
    config I2S_SCK_IO
        int "I2S MCLK GPIO"
        default 8
    config I2S_BCK_IO
        int "I2S BCLK GPIO"
        default 11
    config I2S_WS_IO
        int "I2S LRCK/WS GPIO"
        default 13
    config I2S_DO_IO
        int "I2S DATA OUT GPIO"
        default 12

    config AIRPLAY_OUTPUT_LATENCY_US
        int "Default output latency after the ESP (microseconds)"
        default 0
        range -100000 150000
        help
            Delay added by the hardware after the ESP I2S output (DAC digital
            filter, DSP, digital-input amplifier). The ESP plays this much
            earlier so the sound leaves the speaker on time in multiroom.
            Typical: PCM5102A ~450, DSP with a linear-phase FIR = half its
            length (1024 taps @48 kHz ~10700). The web UI can override it and
            the wired measurement saves the real value; this is only the
            default when nothing has been saved.

    config AIRPLAY_LATENCY_CAL
        bool "Enable wired output-latency measurement (ADC loopback)"
        default y
        help
            Adds a "Measure" button to the web UI. With a wire (through a
            coupling capacitor and bias divider) from the DAC/DSP line output
            to the ADC pin below, the ESP plays short test chirps and measures
            the real output latency. Uses nothing until the button is pressed.

    config AIRPLAY_LATENCY_CAL_GPIO
        int "Loopback ADC input GPIO (ADC1: 1-10)"
        default 4
        range 1 10
        depends on AIRPLAY_LATENCY_CAL
endmenu

menu "RGB Audio/VU LED"
    config ENABLE_RGB_AUDIO_LED
        bool "Enable WS2812 RGB audio/VU LED"
        default y
        help
            Enable a single WS2812 RGB LED driven from final PCM blocks that
            are successfully submitted to I2S. Disable this option to remove
            RGB/VU processing from the audio path.

    config RGB_AUDIO_LED_GPIO
        int "WS2812 data GPIO"
        default 38
        range 0 48
        depends on ENABLE_RGB_AUDIO_LED
        help
            GPIO connected to the WS2812 data input. Use 38 on the current
            board; boards with an onboard RGB LED often use GPIO 48.

    config RGB_AUDIO_LED_BRIGHTNESS
        int "Maximum RGB brightness (0-255)"
        default 96
        range 0 255
        depends on ENABLE_RGB_AUDIO_LED

    config RGB_AUDIO_LED_UPDATE_HZ
        int "VU refresh rate (Hz)"
        default 30
        range 5 60
        depends on ENABLE_RGB_AUDIO_LED
        help
            Limits RMS/bass calculation and WS2812 refresh frequency. The
            upstream implementation uses approximately 30 Hz.

    choice RGB_AUDIO_LED_PLAYING_MODE
        prompt "LED mode while playing"
        default RGB_AUDIO_LED_PLAYING_VU
        depends on ENABLE_RGB_AUDIO_LED
        config RGB_AUDIO_LED_PLAYING_VU
            bool "VU / color music"
        config RGB_AUDIO_LED_PLAYING_STEADY
            bool "Steady green"
        config RGB_AUDIO_LED_PLAYING_OFF
            bool "Off"
    endchoice

    choice RGB_AUDIO_LED_PAUSED_MODE
        prompt "LED mode while paused/connected"
        default RGB_AUDIO_LED_PAUSED_STEADY
        depends on ENABLE_RGB_AUDIO_LED
        config RGB_AUDIO_LED_PAUSED_STEADY
            bool "Steady blue"
        config RGB_AUDIO_LED_PAUSED_OFF
            bool "Off"
    endchoice

    choice RGB_AUDIO_LED_STANDBY_MODE
        prompt "LED mode while disconnected/standby"
        default RGB_AUDIO_LED_STANDBY_OFF
        depends on ENABLE_RGB_AUDIO_LED
        config RGB_AUDIO_LED_STANDBY_OFF
            bool "Off"
        config RGB_AUDIO_LED_STANDBY_STEADY
            bool "Steady dim green"
    endchoice
endmenu
